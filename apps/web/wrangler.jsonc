{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safe-signal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Without this, Cloudflare rejects calls to the sandbox's workers.dev address on the same account (error 1042).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    "SANDBOX_API_URL": "https://taste-difficulties-reference-ancient.trycloudflare.com",
    "EVIDENCE_API_URL": "https://taste-difficulties-reference-ancient.trycloudflare.com/evidence",
    // The Safe Signal API's tunnel, for real calls. Its token is a secret: wrangler secret put LIVE_API_TOKEN
    "LIVE_API_URL": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "ProxyLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProxyLedger"] }],
  // Private link to the T-Life demo. It has no public address.
  "services": [{ "binding": "TLIFE", "service": "safe-signal-tlife-demo", "entrypoint": "NoticeRelay" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The proxy must run before the single-page fallback below can answer.
    "run_worker_first": ["/sandbox-api/*", "/evidence-api/*", "/tlife-api/*", "/live-api/*"],
    // Any path without a file serves index.html, so client-side URLs load directly.
    "not_found_handling": "single-page-application"
  }
}
