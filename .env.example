# Copy to .env and fill in. Never commit .env (R14).

# Nemotron: Brev first, hosted NIM fallback (same OpenAI-compatible client, R13)
# Two Brev vLLM servers sharing one key: fast (Nemotron 3 Nano 4B) and deep (Nemotron Nano 9B v2).
NEMOTRON_BASE_URL=https://<your-brev-fast-endpoint>/v1
NEMOTRON_DEEP_BASE_URL=https://<your-brev-deep-endpoint>/v1
NEMOTRON_API_KEY=
NEMOTRON_MODEL_FAST=nemotron-fast
NEMOTRON_MODEL_PLANNER=nemotron-deep
# Hosted NIM needs real model IDs (Brev uses custom served names). Empty = no fallback for that tier.
NEMOTRON_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_FALLBACK_API_KEY=
NEMOTRON_FALLBACK_MODEL_FAST=
NEMOTRON_FALLBACK_MODEL_PLANNER=

# ElevenLabs Conversational AI (names match the teammate's spikes/tsafe_ref code)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
SCAMMER_AGENT_ID=
# Bank agent for the callback. Must NOT be the scammer agent; the callback refuses to run if it is.
ELEVENLABS_BANK_AGENT_ID=
# Outbound calls need the SIP-trunk number ID (phnum_...); list it with: python spikes/elevenlabs_check.py
ELEVENLABS_PHONE_NUMBER_ID=

# Photon (iMessage)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_TEST_SENDER=
PHOTON_SPACE_ID=
PHOTON_AGENT_USER_ID=
PHOTON_SIDECAR_URL=http://localhost:8787

# Jev (decision layer). Leave empty to use the rule fallback.
JEV_URL=
JEV_API_KEY=

# Tiger Data / Postgres
DATABASE_URL=postgresql://user:pass@host:5432/safesignal

# API
API_URL=http://localhost:8000
# TOOLS=real wires the live adapters (Photon sidecar, ElevenLabs) via services/agents/tools.real_tools().
# Anything else (or empty) uses the in-memory mocks. Tests always use the mocks.
TOOLS=

# Web
NEXT_PUBLIC_API_WS=ws://localhost:8000/ws
NEXT_PUBLIC_REPLAY=true

# Demo: teammates' own numbers only (R10)
DEMO_CUSTOMER_NUMBER=
DEMO_TRUSTED_CONTACT_NUMBER=
DEMO_BANK_NUMBER=
