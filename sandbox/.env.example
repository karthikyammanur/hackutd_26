# Copy to sandbox/.env. Never commit it.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Nemotron served by vLLM on the sandbox's own Brev machine (see brev/setup_models.sh).
NEMOTRON_API_KEY=
NEMOTRON_FAST_URL=http://localhost:8000/v1
NEMOTRON_DEEP_URL=http://localhost:8001/v1
NEMOTRON_FAST_MODEL=nemotron-fast
NEMOTRON_DEEP_MODEL=nemotron-deep
