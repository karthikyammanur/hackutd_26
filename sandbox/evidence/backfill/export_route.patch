+def test_export_result_is_an_allow_list():
+    row = {"outcome": "caught", "tier": "dangerous", "max_p_dangerous": 0.9, "peak_flags": {"asks_for_code": 0.9}, "text": "SECRET"}
+    stored = {
+        "case_id": "c1",
+        "model": "jev-latest",
+        "method": "tech_support",
+        "family": "impersonation",
+        "channel": "call",
+        "weak": 0,
+        "predicted_method": "",
+        "row": json.dumps(row),
+    }
+    exported = c.export_result(stored)
+    assert "SECRET" not in json.dumps(exported)
+    assert exported["predicted_method"] is None and exported["weak"] is False
+    assert exported["row"]["tier"] == "dangerous"
