+EXPORT_ROW_KEYS = (
+    "outcome",
+    "tier",
+    "max_p_dangerous",
+    "first_dangerous_t",
+    "money_moment_t",
+    "caught_before_money",
+    "frames",
+    "frames_answered",
+    "peak_flags",
+)
+
+
+def export_result(stored: dict) -> dict:
+    """One per-case result for the evidence backfill. An allow-list, so no call text can leave this way."""
+    row = json.loads(stored["row"])
+    return {
+        "case_id": stored["case_id"],
+        "model": stored["model"],
+        "method": stored["method"],
+        "family": stored["family"],
+        "channel": stored["channel"],
+        "weak": bool(stored["weak"]),
+        "predicted_method": stored["predicted_method"] or None,
+        "row": {key: row.get(key) for key in EXPORT_ROW_KEYS},
+    }
